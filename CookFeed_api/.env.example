# Copy this file to .env (git ignores .env) before the first `docker compose up`.
# One file serves Docker Compose, the API and the tests; see DOCKER.md.

# The PostgreSQL password for the local container. Any value works; it is fixed when the data volume is
# first created, so to change it later run `docker compose down -v` and start again.
PGPASSWORD=cookfeed-local-only
