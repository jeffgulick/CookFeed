<Project>
  <!-- Settings shared by every project in the solution. A project's own .csproj only says what is different about it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Write packages.lock.json so every machine restores exactly the same package versions,
         including the packages our packages depend on. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
