<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects build as small executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Starts the API in memory, so tests can call its endpoints over HTTP. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cookfeed.Api\Cookfeed.Api.csproj" />
    <ProjectReference Include="..\..\src\Cookfeed.Infrastructure\Cookfeed.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reference SQL in docs/ is the specification these tests check the EF Core database against.
         It is copied next to the test binaries, not duplicated, so there is one copy to keep up to date. -->
    <None Include="..\..\docs\schema.sql" Link="Sql\schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\sql\seed.sql" Link="Sql\seed.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\sql\queries.sql" Link="Sql\queries.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
